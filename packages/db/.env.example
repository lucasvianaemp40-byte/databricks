# @salon/db. Nada aqui é carregado automaticamente; nunca coloque segredos reais neste arquivo.

# Runtime das requisições web: papel app_user (NOSUPERUSER, NOBYPASSRLS, não-dono).
# DATABASE_URL=postgresql://app_user:<senha>@<host>:5432/<banco>?sslmode=verify-full

# Jobs (expirar holds, lembretes): papel app_worker.
# DATABASE_URL_WORKER=postgresql://app_worker:<senha>@<host>:5432/<banco>?sslmode=verify-full

# Somente no deploy (pnpm --filter @salon/db migrate): superusuário ou admin do provedor com
# CREATEROLE e SET no papel app_migrator. Nunca disponível para o runtime da aplicação.
# DATABASE_URL_MIGRATOR=postgresql://<admin>:<senha>@<host>:5432/<banco>?sslmode=verify-full

# Testes de integração: veja o .env.example da raiz (TEST_DATABASE_URL).
