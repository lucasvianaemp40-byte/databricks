{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "env": [
        "APP_ENV",
        "NEXT_PUBLIC_APP_URL"
      ],
      "passThroughEnv": [
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "dev": {
      "passThroughEnv": [
        "APP_ENV",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "typecheck": {
      "env": [
        "APP_ENV",
        "NEXT_PUBLIC_APP_URL"
      ],
      "passThroughEnv": [
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "e2e": {
      "passThroughEnv": [
        "E2E_*",
        "PLAYWRIGHT_*",
        "NEXT_TELEMETRY_DISABLED"
      ]
    }
  }
}
